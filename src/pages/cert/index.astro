---
import BlogLayout from '../../layouts/BlogLayout.astro';

const certs = [
  {
    name: 'Burp Suite Certified Practitioner (BSCP)',
    issuer: 'PortSwigger',
    date: 'May 10, 2026',
    credentialId: '20E9B5DA044B4023',
    image: '/cert/bscp.png',
    description: 'Web security testing certification demonstrating ability to detect and exploit common web vulnerabilities, bypass broken defences, and perform out-of-band attacks.',
  },
  {
    name: 'Certified LLM Security Expert (CLLMSE)',
    issuer: 'Red Team Leaders',
    date: 'November 22, 2026',
    credentialUrl: 'https://courses.redteamleaders.com/exam-completion/3572952b2cd02f7a',
    image: '/cert/cllmse.pdf',
    description: 'LLM security certification covering prompt injection, jailbreaking, model manipulation, and AI red teaming techniques.',
  },
  {
    name: 'Junior Vibe Pentester (JVP)',
    issuer: 'Vibe Security',
    date: 'March 16, 2026',
    credentialId: 'VS-JVP-CERT1608',
    image: '/cert/jvp.png',
    description: 'Fundamental proficiency in Vibe Security methodologies, tools, and techniques through hands-on assessment.',
  },
];
---

<BlogLayout title="Certifications" description="Security certifications earned by Zept.">
  <div class="mb-8 pb-3 border-b border-slate-200 dark:border-slate-800 font-mono">
    <div class="flex items-center gap-2 text-xs mb-1">
      <span class="w-1.5 h-1.5 rounded-full bg-sky-400 animate-pulse"></span>
      <span class="text-slate-400">~/research/</span>
      <span class="text-sky-400">cert</span>
    </div>
    <div class="flex items-center justify-between flex-wrap gap-2">
      <h1 class="text-2xl sm:text-3xl font-extrabold tracking-tight text-slate-900 dark:text-slate-100 flex items-center gap-2.5">
        <span class="text-sky-400">&gt;</span>
        <span>Certifications</span>
      </h1>
      <span class="text-xs px-2.5 py-1 rounded-md bg-sky-950/60 text-sky-400 border border-sky-500/30">
        {certs.length} Earned
      </span>
    </div>
    <p class="mt-4 text-sm leading-relaxed text-slate-600 dark:text-slate-400 font-sans max-w-3xl">
      Professional security certifications and credentials.
    </p>
  </div>

  <div class="space-y-8">
    {certs.map((cert) => (
      <div class="group rounded-2xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-[#0b1324] overflow-hidden hover:border-sky-500/40 hover:shadow-xl hover:shadow-sky-950/20 transition-all">
        {cert.image && (
          <div class="border-b border-slate-200 dark:border-slate-800">
            {cert.image.endsWith('.pdf') ? (
              <embed
                src={cert.image}
                type="application/pdf"
                class="w-full"
                style="height: 600px;"
              />
            ) : (
              <img
                src={cert.image}
                alt={cert.name}
                class="w-full object-contain"
                loading="lazy"
              />
            )}
          </div>
        )}

        <div class="p-5 sm:p-6">
          <div class="flex items-start justify-between flex-wrap gap-3">
            <div class="flex-1 min-w-0">
              <h3 class="text-lg font-bold text-slate-900 dark:text-slate-100 font-mono group-hover:text-sky-400 transition-colors">
                {cert.name}
              </h3>
              <div class="flex flex-wrap items-center gap-x-4 gap-y-1 mt-2 text-xs font-mono text-slate-500 dark:text-slate-400">
                <span class="flex items-center gap-1.5">
                  <span class="w-1.5 h-1.5 rounded-full bg-sky-400"></span>
                  {cert.issuer}
                </span>
                <span>{cert.date}</span>
                {cert.credentialId && (
                  <span class="text-slate-400 dark:text-slate-500">ID: {cert.credentialId}</span>
                )}
              </div>
              {cert.description && (
                <p class="text-sm text-slate-600 dark:text-slate-400 mt-3 font-sans leading-relaxed">
                  {cert.description}
                </p>
              )}
            </div>
          </div>

          {cert.credentialUrl && (
            <a
              href={cert.credentialUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-1.5 mt-4 px-3 py-1.5 text-xs font-mono font-medium text-sky-400 bg-sky-500/10 border border-sky-500/30 rounded-lg hover:bg-sky-500/20 hover:border-sky-400 transition-all"
            >
              <span>Verify credential</span>
              <svg class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
              </svg>
            </a>
          )}
        </div>
      </div>
    ))}
  </div>
</BlogLayout>
